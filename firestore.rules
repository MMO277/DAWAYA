rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() { return request.auth != null; }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid && uid.size() > 0;
    }

    function roleDocPath() {
      return /databases/$(database)/documents/roles/$(request.auth.uid);
    }

    function isAccountNotSuspended() {
      return !exists(roleDocPath())
          || !('accountStatus' in get(roleDocPath()).data)
          || get(roleDocPath()).data.accountStatus != 'suspended';
    }

    // Section 3: Share is valid ONLY when not revoked AND expiresAt is strictly in the future (> request.time)
    function isPassportShareDocValid(shareData) {
      return shareData.revoked != true
          && (
            (shareData.expiresAt is int && shareData.expiresAt > request.time.toMillis())
            || (shareData.expiresAt is number && shareData.expiresAt > request.time.toMillis())
            || (shareData.expiresAt is timestamp && shareData.expiresAt > request.time)
          );
    }

    function isPassportActivelyShared(uid) {
      return exists(/databases/$(database)/documents/passportShares/$(uid))
          && isPassportShareDocValid(get(/databases/$(database)/documents/passportShares/$(uid)).data);
    }

    // Section 3 & 10: Users can NEVER assign themselves roles or elevated permissions in their own user doc
    function validUserDocWrite() {
      let d = request.resource.data;
      return (!('schedules' in d) || d.schedules is list)
          && (!('deletedScheduleIds' in d) || d.deletedScheduleIds is map)
          && (!('prescriptions' in d) || d.prescriptions is list)
          && (!('deletedPrescriptionIds' in d) || d.deletedPrescriptionIds is map)
          && (!('treatmentEvents' in d) || d.treatmentEvents is list)
          && (!('radarWorkspace' in d) || d.radarWorkspace is map)
          && (!('healthProfile' in d) || d.healthProfile is map)
          && (!('medicalDocuments' in d) || d.medicalDocuments is list)
          && (!('patientAuditLogs' in d) || d.patientAuditLogs is list)
          && (!('reminders' in d) || d.reminders is list)
          && (!('learnDone' in d) || d.learnDone is list)
          && (!('certificates' in d) || d.certificates is list)
          && (!('aiConversation' in d) || d.aiConversation is list)
          && (!('savedAddresses' in d) || d.savedAddresses is list)
          && (!('notificationPrefs' in d) || d.notificationPrefs is map)
          && (!('defaultRole' in d) || d.defaultRole == 'patient')
          && !('role' in d)
          && !('roles' in d)
          && !('permissions' in d)
          && !('isAdmin' in d);
    }

    // Multi-role & canonical/legacy role verification (never trusts client-side activeRole UI preference)
    function userHasRoleIn(allowedRoles) {
      return isSignedIn()
          && isAccountNotSuspended()
          && (
            (request.auth.token.role is string && request.auth.token.role in allowedRoles)
            || (
              exists(roleDocPath())
              && get(roleDocPath()).data.status != 'revoked'
              && (
                (get(roleDocPath()).data.role in allowedRoles)
                || ('canonicalRole' in get(roleDocPath()).data && get(roleDocPath()).data.canonicalRole in allowedRoles)
                || ('roles' in get(roleDocPath()).data && get(roleDocPath()).data.roles is list && get(roleDocPath()).data.roles.hasAny(allowedRoles))
              )
            )
          );
    }

    // Central Platform & Content Roles (Canonical + Legacy aliases)
    function isViewer() {
      return userHasRoleIn([
        'viewer',
        'editor', 'content_editor',
        'reviewer', 'content_reviewer',
        'regional_manager',
        'admin', 'central_admin',
        'super_admin', 'owner'
      ]);
    }
    function isEditor() {
      return userHasRoleIn([
        'editor', 'content_editor',
        'reviewer', 'content_reviewer',
        'regional_manager',
        'admin', 'central_admin',
        'super_admin', 'owner'
      ]);
    }
    function isReviewer() {
      return userHasRoleIn([
        'reviewer', 'content_reviewer',
        'regional_manager',
        'admin', 'central_admin',
        'super_admin', 'owner'
      ]);
    }
    function isRegionalManager() {
      return userHasRoleIn([
        'regional_manager',
        'admin', 'central_admin',
        'super_admin', 'owner'
      ]);
    }
    function isScopedRegionalManagerFor(govId) {
      let regMemPath = /databases/$(database)/documents/regionalMemberships/$(request.auth.uid + '_' + govId);
      return isAdmin()
          || (
            isRegionalManager()
            && (
              (exists(regMemPath) && get(regMemPath).data.status == 'active')
              || (exists(roleDocPath()) && (!('regionId' in get(roleDocPath()).data) || get(roleDocPath()).data.regionId == null || get(roleDocPath()).data.regionId == govId))
            )
          );
    }
    function isAdmin() {
      return userHasRoleIn(['admin', 'central_admin', 'super_admin', 'owner']);
    }
    function isPlatformOwner() {
      return userHasRoleIn(['super_admin', 'owner']);
    }

    // Section 5 & 9: Strict Pharmacy Tenant Isolation & Scoped Membership Helpers
    function pharmMembershipPath(pharmacyId) {
      return /databases/$(database)/documents/pharmacyMemberships/$(request.auth.uid + '_' + pharmacyId);
    }

    function hasActiveScopedPharmacyMembership(pharmacyId, allowedRoles) {
      let pPath = pharmMembershipPath(pharmacyId);
      return exists(pPath)
          && get(pPath).data.status == 'active'
          && get(pPath).data.pharmacyId == pharmacyId
          && get(pPath).data.role in allowedRoles;
    }

    function isPharmacyMember(pharmacyId) {
      return isSignedIn()
          && isAccountNotSuspended()
          && pharmacyId is string
          && pharmacyId.size() > 0
          && (
            isAdmin()
            || hasActiveScopedPharmacyMembership(pharmacyId, [
              'pharmacy_owner', 'pharmacy_manager', 'pharmacist', 'pharmacy_employee', 'employee'
            ])
            || (
              exists(roleDocPath())
              && get(roleDocPath()).data.pharmacyId == pharmacyId
              && get(roleDocPath()).data.role in [
                'pharmacy_owner', 'pharmacy_manager', 'pharmacist', 'pharmacy_employee', 'employee'
              ]
            )
            || (
              exists(/databases/$(database)/documents/pharmacies/$(pharmacyId))
              && get(/databases/$(database)/documents/pharmacies/$(pharmacyId)).data.ownerUid == request.auth.uid
            )
            || (
              exists(/databases/$(database)/documents/partners/$(pharmacyId))
              && get(/databases/$(database)/documents/partners/$(pharmacyId)).data.ownerUid == request.auth.uid
            )
          );
    }

    function isPharmacyPharmacistOrManager(pharmacyId) {
      let pPath = pharmMembershipPath(pharmacyId);
      return isSignedIn()
          && isAccountNotSuspended()
          && pharmacyId is string
          && pharmacyId.size() > 0
          && (
            isAdmin()
            || hasActiveScopedPharmacyMembership(pharmacyId, [
              'pharmacy_owner', 'pharmacy_manager', 'pharmacist'
            ])
            || (
              exists(pPath)
              && get(pPath).data.status == 'active'
              && get(pPath).data.pharmacyId == pharmacyId
              && ('permissions' in get(pPath).data)
              && (get(pPath).data.permissions is list)
              && get(pPath).data.permissions.hasAny(['inventory.manage'])
            )
            || (
              exists(roleDocPath())
              && get(roleDocPath()).data.pharmacyId == pharmacyId
              && get(roleDocPath()).data.role in ['pharmacy_owner', 'pharmacy_manager', 'pharmacist']
            )
            || (
              exists(/databases/$(database)/documents/pharmacies/$(pharmacyId))
              && get(/databases/$(database)/documents/pharmacies/$(pharmacyId)).data.ownerUid == request.auth.uid
            )
            || (
              exists(/databases/$(database)/documents/partners/$(pharmacyId))
              && get(/databases/$(database)/documents/partners/$(pharmacyId)).data.ownerUid == request.auth.uid
            )
          );
    }

    function isPharmacyManagerOrOwner(pharmacyId) {
      return isSignedIn()
          && isAccountNotSuspended()
          && pharmacyId is string
          && pharmacyId.size() > 0
          && (
            isAdmin()
            || hasActiveScopedPharmacyMembership(pharmacyId, ['pharmacy_owner', 'pharmacy_manager'])
            || (
              exists(roleDocPath())
              && get(roleDocPath()).data.pharmacyId == pharmacyId
              && get(roleDocPath()).data.role in ['pharmacy_owner', 'pharmacy_manager']
            )
            || (
              exists(/databases/$(database)/documents/pharmacies/$(pharmacyId))
              && get(/databases/$(database)/documents/pharmacies/$(pharmacyId)).data.ownerUid == request.auth.uid
            )
            || (
              exists(/databases/$(database)/documents/partners/$(pharmacyId))
              && get(/databases/$(database)/documents/partners/$(pharmacyId)).data.ownerUid == request.auth.uid
            )
          );
    }

    // Section 2: Strict field allowlist for pharmacy applicants updating draft/pending applications
    function validApplicantApplicationUpdate() {
      return isSignedIn()
          && resource.data.applicantUid == request.auth.uid
          && request.resource.data.applicantUid == resource.data.applicantUid
          && resource.data.status in ['draft', 'pending_review']
          && request.resource.data.status in ['draft', 'pending_review']
          && request.resource.data.pharmacyNameAr is string
          && request.resource.data.pharmacyNameAr.size() >= 2
          && request.resource.data.licenseNumber is string
          && request.resource.data.licenseNumber.size() >= 3
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'pharmacyNameAr',
            'pharmacyNameEn',
            'licenseNumber',
            'commercialRegistryNumber',
            'taxCardNumber',
            'ownerFullName',
            'pharmacistManagerName',
            'syndicateRegistrationNumber',
            'nationalIdLast4',
            'phone',
            'whatsapp',
            'applicantEmail',
            'governorateId',
            'cityCenter',
            'districtVillage',
            'detailedAddressAr',
            'latitude',
            'longitude',
            'workingHoursAr',
            'is24Hours',
            'deliveryAvailable',
            'deliveryRadiusKm',
            'licenseDocumentUrl',
            'syndicateCardUrl',
            'logoUrl',
            'requestedModel',
            'status',
            'updatedAtIso'
          ]);
    }

    // Section 4: Explicit Order State Machine Validation
    function isValidOrderTransition(oldStatus, newStatus) {
      return (oldStatus in ['new_order', 'pending_review', 'pending_pharmacy_review']
              && newStatus in ['pharmacy_confirmation', 'confirmed_available', 'rejected', 'cancelled'])
          || (oldStatus in ['pharmacy_confirmation', 'confirmed_available']
              && newStatus in ['preparing', 'cancelled', 'rejected'])
          || (oldStatus == 'preparing'
              && newStatus in ['ready_for_delivery', 'ready_for_pickup_or_delivery', 'out_for_delivery', 'cancelled'])
          || (oldStatus in ['ready_for_delivery', 'ready_for_pickup_or_delivery']
              && newStatus in ['out_for_delivery', 'delivered', 'completed'])
          || (oldStatus == 'out_for_delivery'
              && newStatus in ['delivered', 'completed']);
    }

    // ── 1. Users & Customer Profiles (Protected Personal & Medical Data) ──
    match /users/{uid} {
      // Section 3 & 6F Fix: Private patient records are strictly private to the owner (never content_editor/content_reviewer/regional_manager)
      allow read: if isOwner(uid);
      allow create, update: if isOwner(uid) && validUserDocWrite();
      allow delete: if isOwner(uid) || isAdmin();

      match /auditLogs/{logId} {
        allow read: if isOwner(uid) || isAdmin();
        allow create: if isOwner(uid)
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.actionType is string
          && request.resource.data.timestamp is string;
        allow update, delete: if false;
      }

      match /medicalDocuments/{docId} {
        // Section 3 & 6F Fix: Only the patient owner can read/write their private medical documents
        allow read: if isOwner(uid);
        allow create, update: if isOwner(uid)
          && request.resource.data.category in ['prescription', 'lab_report', 'medical_report', 'leaflet', 'other']
          && request.resource.data.fileName is string
          && request.resource.data.fileName.size() <= 255;
        allow delete: if isOwner(uid);
      }

      match /reminders/{reminderId} {
        allow read, write: if isOwner(uid);
      }

      match /gameProgress/{gameId} {
        allow read, write: if isOwner(uid);
      }

      // Section 4 Fix: Secure Notifications — users can only create self-notifications for themselves; no cross-user spoofing
      match /notifications/{notifId} {
        allow read: if isOwner(uid);
        allow create: if (
            isOwner(uid)
            && request.resource.data.uid == request.auth.uid
            && request.resource.data.source == 'user_self'
            && request.resource.data.type in ['dose_reminder', 'appointment_note', 'personal_alert']
            && request.resource.data.title is string
            && request.resource.data.title.size() >= 1
            && request.resource.data.title.size() <= 200
            && request.resource.data.keys().hasOnly(['uid', 'source', 'type', 'title', 'body', 'read', 'createdAtIso'])
          )
          || isAdmin();
        allow update: if isOwner(uid)
          && request.resource.data.uid == resource.data.uid
          && request.resource.data.source == resource.data.source
          && request.resource.data.type == resource.data.type
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read', 'readAtIso']);
        allow delete: if isOwner(uid) || isAdmin();
      }
    }

    // Default Patient Registration Profile (Section 3 & 8)
    match /customerProfiles/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow create: if isOwner(uid)
        && (!('defaultRole' in request.resource.data) || request.resource.data.defaultRole == 'patient')
        && (!('accountStatus' in request.resource.data) || request.resource.data.accountStatus == 'active')
        && !('role' in request.resource.data)
        && !('roles' in request.resource.data)
        && !('permissions' in request.resource.data)
        && !('isAdmin' in request.resource.data);
      allow update: if (
          isOwner(uid)
          && (!('defaultRole' in request.resource.data) || request.resource.data.defaultRole == 'patient')
          && (!('accountStatus' in request.resource.data) || request.resource.data.accountStatus == resource.data.accountStatus)
          && !('role' in request.resource.data)
          && !('roles' in request.resource.data)
          && !('permissions' in request.resource.data)
          && !('isAdmin' in request.resource.data)
        )
        || isAdmin();
      allow delete: if isAdmin();
    }

    // ── 1B. Multi-Role, Scoped Memberships, Role Definitions & Audit Logs (Sections 7, 8, 10, 11) ──
    match /roles/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      // Privilege escalation prevention: only super_admin/owner can assign super_admin or central_admin
      allow create, update: if isPlatformOwner()
        || (
          isAdmin()
          && !(request.resource.data.role in ['super_admin', 'owner', 'central_admin', 'admin'])
          && !('canonicalRole' in request.resource.data && request.resource.data.canonicalRole in ['super_admin', 'central_admin'])
        );
      allow delete: if isPlatformOwner() || (isAdmin() && uid != request.auth.uid);
    }

    match /userRoles/{roleDocId} {
      allow read: if isSignedIn() && (resource.data.uid == request.auth.uid || isAdmin());
      allow create, update: if isPlatformOwner()
        || (
          isAdmin()
          && request.resource.data.uid is string
          && !(request.resource.data.role in ['super_admin', 'owner', 'central_admin', 'admin'])
        );
      allow delete: if isPlatformOwner();
    }

    match /pharmacyMemberships/{memId} {
      allow read: if isSignedIn() && (
        resource.data.uid == request.auth.uid
        || isPharmacyManagerOrOwner(resource.data.pharmacyId)
        || isAdmin()
      );
      allow create: if isAdmin()
        || (
          isSignedIn()
          && request.resource.data.pharmacyId is string
          && isPharmacyManagerOrOwner(request.resource.data.pharmacyId)
          && request.resource.data.role in ['pharmacy_manager', 'pharmacist', 'pharmacy_employee', 'employee']
        );
      allow update: if isAdmin()
        || (
          isSignedIn()
          && request.resource.data.pharmacyId == resource.data.pharmacyId
          && isPharmacyManagerOrOwner(resource.data.pharmacyId)
          && request.resource.data.role in ['pharmacy_manager', 'pharmacist', 'pharmacy_employee', 'employee']
        );
      allow delete: if isAdmin()
        || (isSignedIn() && isPharmacyManagerOrOwner(resource.data.pharmacyId));
    }

    match /regionalMemberships/{regMemId} {
      allow read: if isSignedIn() && (
        resource.data.uid == request.auth.uid
        || isRegionalManager()
        || isAdmin()
      );
      allow create, update, delete: if isAdmin();
    }

    match /roleDefinitions/{roleId} {
      allow read: if isSignedIn();
      allow write: if isPlatformOwner();
    }

    match /auditLogs/{logId} {
      allow read: if isAdmin();
      allow create: if isSignedIn()
        && request.resource.data.actorUid == request.auth.uid
        && request.resource.data.targetUid is string
        && request.resource.data.action is string
        && request.resource.data.timestamp is string;
      allow update, delete: if false;
    }

    // ── 2. Medication Database & Clinical Catalog ──
    match /medicines/{id} {
      allow read: if true;
      allow create, update: if isEditor() || isReviewer() || isAdmin();
      allow delete: if isAdmin();
    }

    match /medicines_catalog/{id} {
      allow read: if true;
      allow create, update: if isEditor() || isReviewer() || isAdmin();
      allow delete: if isAdmin();
    }

    match /articles/{id} {
      allow read: if true;
      allow create, update: if isEditor() || isReviewer() || isAdmin();
      allow delete: if isAdmin();
    }

    match /dataSources/{id} {
      allow read: if isViewer();
      allow create, update: if isEditor() || isAdmin();
      allow delete: if isAdmin();
    }

    match /settings/{docId} {
      // Section 2 & 6 Fix: Never allow public reads of legacy gbridge_* or ai_config documents
      allow read: if !(docId.matches('gbridge_.*')) && docId != 'ai_config' && docId != 'google_app_accounts_list';
      allow write: if isAdmin();
    }

    match /system_config/{docId} {
      allow read: if docId != 'ai_secrets';
      allow write: if isAdmin();
    }

    match /systemSettings/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Server-only distributed rate limiting store
    match /_rateLimits/{limitId} {
      allow read, write: if false;
    }

    // ── 3. Dynamic Geographic Hierarchy (Egypt -> Governorate -> City/Center -> District/Village) ──
    match /governorates/{govId} {
      allow read: if true;
      allow write: if isAdmin() || isScopedRegionalManagerFor(govId);
    }

    match /centers/{centerId} {
      allow read: if true;
      allow write: if isAdmin() || isRegionalManager();
    }

    match /villages/{villageId} {
      allow read: if true;
      allow write: if isAdmin() || isRegionalManager();
    }

    // ── 4. DAWAYA Pharmacy Network, Applications, Inventory & Employees (Strict Tenant Isolation) ──
    match /pharmacyApplications/{appId} {
      allow create: if isSignedIn()
        && request.resource.data.applicantUid == request.auth.uid
        && request.resource.data.pharmacyNameAr is string
        && request.resource.data.pharmacyNameAr.size() >= 2
        && request.resource.data.licenseNumber is string
        && request.resource.data.licenseNumber.size() >= 3
        && request.resource.data.status in ['draft', 'pending_review']
        && !('approvedPharmacyId' in request.resource.data)
        && !('reviewedByUid' in request.resource.data);
      // Section 3 & 6E Fix: Only applicant, scoped Regional Manager for that governorate, or Admin can read applications
      allow read: if isSignedIn() && (
        resource.data.applicantUid == request.auth.uid
        || isScopedRegionalManagerFor(resource.data.governorateId)
        || isAdmin()
      );
      allow update: if validApplicantApplicationUpdate()
        || ((isAdmin() || isScopedRegionalManagerFor(resource.data.governorateId))
            && request.resource.data.applicantUid == resource.data.applicantUid);
      allow delete: if isAdmin();
    }

    match /pharmacies/{pharmacyId} {
      allow read: if resource.data.status == 'approved'
        || isPharmacyMember(pharmacyId)
        || isScopedRegionalManagerFor(resource.data.governorateId)
        || isAdmin();
      allow create: if isAdmin() || isScopedRegionalManagerFor(request.resource.data.governorateId);
      // Section 5 Fix: Pharmacy owner can only update operational contact/hours fields, never status, ownerUid, or licenseNumber
      allow update: if (
          isPharmacyManagerOrOwner(pharmacyId)
          && request.resource.data.status == resource.data.status
          && request.resource.data.ownerUid == resource.data.ownerUid
          && request.resource.data.licenseNumber == resource.data.licenseNumber
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'phone',
            'whatsapp',
            'workingHoursAr',
            'is24Hours',
            'deliveryAvailable',
            'deliveryRadiusKm',
            'detailedAddressAr',
            'updatedAtIso'
          ])
        )
        || isAdmin()
        || isScopedRegionalManagerFor(resource.data.governorateId);
      allow delete: if isAdmin();
    }

    match /pharmacyEmployees/{empId} {
      allow read: if isSignedIn() && (
        resource.data.uid == request.auth.uid
        || isPharmacyManagerOrOwner(resource.data.pharmacyId)
        || isAdmin()
      );
      allow create: if isSignedIn()
        && request.resource.data.pharmacyId is string
        && request.resource.data.role in ['pharmacy_manager', 'pharmacist', 'pharmacy_employee', 'employee']
        && (isPharmacyManagerOrOwner(request.resource.data.pharmacyId) || isAdmin());
      // Section 5 Fix: pharmacyId is strictly immutable on update to prevent cross-pharmacy employee reassignment
      allow update: if isSignedIn()
        && request.resource.data.pharmacyId == resource.data.pharmacyId
        && request.resource.data.role in ['pharmacy_manager', 'pharmacist', 'pharmacy_employee', 'employee']
        && (isPharmacyManagerOrOwner(resource.data.pharmacyId) || isAdmin());
      allow delete: if isSignedIn() && (
        isPharmacyManagerOrOwner(resource.data.pharmacyId)
        || isAdmin()
      );
    }

    // Section 5 & 9 Fix: Private operational inventory restricted to pharmacy clinical staff/managers & immutable pharmacyId
    match /pharmacyInventory/{invId} {
      allow read: if isSignedIn() && (
        isPharmacyMember(resource.data.pharmacyId)
        || isAdmin()
      );
      allow create: if isSignedIn()
        && request.resource.data.pharmacyId is string
        && isPharmacyPharmacistOrManager(request.resource.data.pharmacyId)
        && request.resource.data.quantityPacks is number
        && request.resource.data.quantityPacks >= 0
        && request.resource.data.pharmacyPriceEgp is number
        && request.resource.data.pharmacyPriceEgp > 0
        && request.resource.data.stockStatus in ['available', 'low_stock', 'out_of_stock', 'unconfirmed'];
      allow update: if isSignedIn()
        && request.resource.data.pharmacyId == resource.data.pharmacyId
        && isPharmacyPharmacistOrManager(resource.data.pharmacyId)
        && request.resource.data.quantityPacks is number
        && request.resource.data.quantityPacks >= 0
        && request.resource.data.pharmacyPriceEgp is number
        && request.resource.data.pharmacyPriceEgp > 0
        && request.resource.data.stockStatus in ['available', 'low_stock', 'out_of_stock', 'unconfirmed'];
      allow delete: if isSignedIn()
        && isPharmacyManagerOrOwner(resource.data.pharmacyId);
    }

    // Section 5 & 9 Fix: Public availability projection exposing ONLY intentional public catalog/availability fields
    match /pharmacyPublicInventory/{invId} {
      allow read: if true;
      allow create: if isSignedIn()
        && request.resource.data.pharmacyId is string
        && isPharmacyPharmacistOrManager(request.resource.data.pharmacyId)
        && request.resource.data.pharmacyPriceEgp is number
        && request.resource.data.pharmacyPriceEgp > 0
        && request.resource.data.stockStatus in ['available', 'low_stock', 'out_of_stock', 'unconfirmed']
        && request.resource.data.keys().hasOnly([
          'id',
          'pharmacyId',
          'medicationId',
          'tradeNameAr',
          'tradeNameEn',
          'activeIngredient',
          'strength',
          'dosageForm',
          'pharmacyPriceEgp',
          'stockStatus',
          'requiresPrescription',
          'lastUpdatedAtIso'
        ]);
      allow update: if isSignedIn()
        && request.resource.data.pharmacyId == resource.data.pharmacyId
        && isPharmacyPharmacistOrManager(resource.data.pharmacyId)
        && request.resource.data.pharmacyPriceEgp is number
        && request.resource.data.pharmacyPriceEgp > 0
        && request.resource.data.stockStatus in ['available', 'low_stock', 'out_of_stock', 'unconfirmed']
        && request.resource.data.keys().hasOnly([
          'id',
          'pharmacyId',
          'medicationId',
          'tradeNameAr',
          'tradeNameEn',
          'activeIngredient',
          'strength',
          'dosageForm',
          'pharmacyPriceEgp',
          'stockStatus',
          'requiresPrescription',
          'lastUpdatedAtIso'
        ]);
      allow delete: if isSignedIn()
        && isPharmacyManagerOrOwner(resource.data.pharmacyId);
    }

    // ── 5. Franchise Management & Financial Records (Strictly Protected) ──
    match /franchiseContracts/{contractId} {
      allow read: if isAdmin()
        || (isSignedIn() && resource.data.pharmacyId is string && isPharmacyManagerOrOwner(resource.data.pharmacyId));
      allow write: if isAdmin();
    }

    match /franchisePayments/{paymentId} {
      allow read: if isAdmin()
        || (isSignedIn() && resource.data.pharmacyId is string && isPharmacyManagerOrOwner(resource.data.pharmacyId));
      allow create: if isAdmin()
        || (isSignedIn()
            && request.resource.data.pharmacyId is string
            && isPharmacyManagerOrOwner(request.resource.data.pharmacyId)
            && request.resource.data.amountEgp is number
            && request.resource.data.amountEgp > 0);
      allow update, delete: if isAdmin();
    }

    match /subscriptions/{subId} {
      allow read: if isAdmin()
        || (isSignedIn() && resource.data.pharmacyId is string && isPharmacyManagerOrOwner(resource.data.pharmacyId));
      allow write: if isAdmin();
    }

    // ── 6. Partner Management & Pharmacy Network Collections (Section 5 Tenant Isolation) ──
    match /partners/{partnerId} {
      allow read: if true;
      allow create: if isAdmin()
        && request.resource.data.nameAr is string
        && request.resource.data.nameEn is string;
      // Section 5 Fix: Pharmacy owner can only update operational contact/hours fields; cannot self-verify, self-publish, or change ownerUid
      allow update: if isAdmin()
        || (
          isPharmacyManagerOrOwner(partnerId)
          && request.resource.data.ownerUid == resource.data.ownerUid
          && request.resource.data.verificationStatus == resource.data.verificationStatus
          && request.resource.data.partnershipStatus == resource.data.partnershipStatus
          && request.resource.data.publicationStatus == resource.data.publicationStatus
          && request.resource.data.visibilityStatus == resource.data.visibilityStatus
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'phone',
            'hotline',
            'publicEmail',
            'websiteUrl',
            'socialLinks',
            'workingHoursAr',
            'workingHoursEn',
            'is24Hours',
            'deliveryAvailable',
            'deliveryCoverageAr',
            'deliveryCoverageEn',
            'servicesOfferedAr',
            'servicesOfferedEn',
            'updatedAtIso'
          ])
        );
      allow delete: if isAdmin();
    }

    match /partnerPrivateAdmin/{partnerId} {
      allow read: if isAdmin() || isPharmacyManagerOrOwner(partnerId);
      allow create, update, delete: if isAdmin();
    }

    match /partnerCategories/{categoryId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /partnerBranches/{branchId} {
      allow read: if true;
      allow create: if isAdmin()
        || (isSignedIn()
            && request.resource.data.partnerId is string
            && isPharmacyManagerOrOwner(request.resource.data.partnerId)
            && request.resource.data.published == false);
      // Section 5 Fix: partnerId is immutable; non-admin pharmacy owner cannot alter published status directly
      allow update: if isAdmin()
        || (isSignedIn()
            && resource.data.partnerId is string
            && request.resource.data.partnerId == resource.data.partnerId
            && request.resource.data.published == resource.data.published
            && isPharmacyManagerOrOwner(resource.data.partnerId));
      allow delete: if isAdmin();
    }

    match /partnerServiceAreas/{areaId} {
      allow read: if true;
      allow write: if isAdmin() || isRegionalManager();
    }

    match /partnerVisibility/{partnerId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /partnerIntegrations/{partnerId} {
      allow read: if isAdmin() || isPharmacyManagerOrOwner(partnerId);
      allow write: if isAdmin();
    }

    match /partnerMedicationMappings/{mappingId} {
      allow read: if true;
      allow create: if isAdmin()
        || (isSignedIn()
            && request.resource.data.partnerId is string
            && isPharmacyPharmacistOrManager(request.resource.data.partnerId));
      // Section 5 Fix: partnerId is immutable on update
      allow update: if isAdmin()
        || (isSignedIn()
            && resource.data.partnerId is string
            && request.resource.data.partnerId == resource.data.partnerId
            && isPharmacyPharmacistOrManager(resource.data.partnerId));
      allow delete: if isAdmin()
        || (isSignedIn()
            && resource.data.partnerId is string
            && isPharmacyManagerOrOwner(resource.data.partnerId));
    }

    match /partnerPromotions/{promoId} {
      allow read: if (resource.data.active == true) || isViewer();
      allow write: if isAdmin();
    }

    // Section 4 & 5 Fix: Partner Orders & Customer Orders enforce state machine + tenant isolation + immutable fields
    match /partnerOrders/{orderId} {
      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.patientName is string
        && request.resource.data.patientName.size() >= 2
        && request.resource.data.patientPhone is string
        && request.resource.data.patientPhone.size() >= 8
        && request.resource.data.partnerId is string
        && request.resource.data.quantity is number
        && request.resource.data.quantity > 0
        && request.resource.data.status in ['new_order', 'pending_review', 'pending_pharmacy_review'];
      allow read: if isSignedIn() && (
        resource.data.userId == request.auth.uid
        || isPharmacyMember(resource.data.partnerId)
        || isAdmin()
      );
      allow update: if isSignedIn()
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.partnerId == resource.data.partnerId
        && request.resource.data.medicationId == resource.data.medicationId
        && request.resource.data.quantity == resource.data.quantity
        && request.resource.data.createdAtIso == resource.data.createdAtIso
        && (
          (
            resource.data.userId == request.auth.uid
            && resource.data.status in ['new_order', 'pending_review', 'pending_pharmacy_review']
            && request.resource.data.status == 'cancelled'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAtIso', 'statusHistory'])
          )
          || (
            (isPharmacyMember(resource.data.partnerId) || isAdmin())
            && isValidOrderTransition(resource.data.status, request.resource.data.status)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAtIso', 'statusHistory', 'pharmacyNotes', 'assignedPharmacistUid'])
          )
        );
      allow delete: if isAdmin();
    }

    match /orders/{orderId} {
      allow create: if isSignedIn()
        && request.resource.data.customerUid == request.auth.uid
        && request.resource.data.pharmacyId is string
        && request.resource.data.status == 'new_order';
      allow read: if isSignedIn() && (
        resource.data.customerUid == request.auth.uid
        || isPharmacyMember(resource.data.pharmacyId)
        || isAdmin()
      );
      allow update: if isSignedIn()
        && request.resource.data.customerUid == resource.data.customerUid
        && request.resource.data.pharmacyId == resource.data.pharmacyId
        && request.resource.data.createdAtIso == resource.data.createdAtIso
        && (
          (
            resource.data.customerUid == request.auth.uid
            && resource.data.status == 'new_order'
            && request.resource.data.status == 'cancelled'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAtIso', 'statusHistory'])
          )
          || (
            (isPharmacyMember(resource.data.pharmacyId) || isAdmin())
            && isValidOrderTransition(resource.data.status, request.resource.data.status)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAtIso', 'statusHistory', 'pharmacyNotes', 'assignedPharmacistUid'])
          )
        );
      allow delete: if isAdmin();
    }

    match /adminAuditLogs/{logId} {
      allow read: if isAdmin();
      allow create: if isSignedIn()
        && (
          isEditor()
          || isReviewer()
          || isRegionalManager()
          || isAdmin()
          || (request.resource.data.partnerId is string && isPharmacyMember(request.resource.data.partnerId))
        )
        && request.resource.data.adminUid == request.auth.uid
        && request.resource.data.timestampIso is string
        && request.resource.data.action is string;
      allow update, delete: if false;
    }

    // ── 7. Surveys, Research & Analytics ──
    match /surveyResponses/{id} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    match /surveyConfig/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /researchResponses/{id} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    match /researchConfig/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /assessmentPairs/{id} {
      allow create, update: if true;
      allow read, delete: if isAdmin();
    }

    match /learningAnalytics/{id} {
      allow create: if true;
      allow read, delete: if isAdmin();
      allow update: if false;
    }

    match /quizResults/{resultId} {
      allow create: if true;
      allow read: if isSignedIn();
      allow update, delete: if false;
    }

    // ── 8. Smart Patient Passport ──
    match /passportShares/{uid} {
      allow read, write: if isOwner(uid);
      allow get: if isOwner(uid) || isPassportShareDocValid(resource.data);
      allow list: if isOwner(uid);
    }

    match /passportShares/{uid}/accessLogs/{logId} {
      allow create: if isPassportActivelyShared(uid)
        && request.resource.data.accessedAt is number
        && request.resource.data.note is string;
      allow read: if isOwner(uid);
      allow update, delete: if false;
    }
  }
}
