rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid && uid.size() > 0;
    }

    // Strictly system administrators only (NOT editor, reviewer, or regional_manager)
    function isSystemAdmin() {
      return isSignedIn() && (
        request.auth.token.role in ['owner', 'super_admin', 'admin']
        || (
          firestore.exists(/databases/(default)/documents/roles/$(request.auth.uid))
          && firestore.get(/databases/(default)/documents/roles/$(request.auth.uid)).data.role in ['owner', 'super_admin', 'admin']
        )
      );
    }

    // Authorized to verify pharmacy licenses (System Admin or Regional Manager ONLY — never editor/reviewer)
    function isLicenseVerifier() {
      return isSignedIn() && (
        request.auth.token.role in ['owner', 'super_admin', 'admin', 'regional_manager']
        || (
          firestore.exists(/databases/(default)/documents/roles/$(request.auth.uid))
          && firestore.get(/databases/(default)/documents/roles/$(request.auth.uid)).data.role in ['owner', 'super_admin', 'admin', 'regional_manager']
        )
      );
    }

    // Clinical pharmacy staff (owner, manager, licensed pharmacist) of a specific pharmacy tenant
    function isPharmacyClinicalStaff(partnerId) {
      return isSignedIn()
        && partnerId is string
        && partnerId.size() > 0
        && (
          (
            firestore.exists(/databases/(default)/documents/roles/$(request.auth.uid))
            && firestore.get(/databases/(default)/documents/roles/$(request.auth.uid)).data.pharmacyId == partnerId
            && firestore.get(/databases/(default)/documents/roles/$(request.auth.uid)).data.role in ['pharmacy_owner', 'pharmacy_manager', 'pharmacist']
          )
          || (
            firestore.exists(/databases/(default)/documents/pharmacies/$(partnerId))
            && firestore.get(/databases/(default)/documents/pharmacies/$(partnerId)).data.ownerUid == request.auth.uid
          )
        );
    }

    function isPharmacyManagerOrOwner(partnerId) {
      return isSignedIn()
        && partnerId is string
        && partnerId.size() > 0
        && (
          isSystemAdmin()
          || (
            firestore.exists(/databases/(default)/documents/roles/$(request.auth.uid))
            && firestore.get(/databases/(default)/documents/roles/$(request.auth.uid)).data.pharmacyId == partnerId
            && firestore.get(/databases/(default)/documents/roles/$(request.auth.uid)).data.role in ['pharmacy_owner', 'pharmacy_manager']
          )
          || (
            firestore.exists(/databases/(default)/documents/pharmacies/$(partnerId))
            && firestore.get(/databases/(default)/documents/pharmacies/$(partnerId)).data.ownerUid == request.auth.uid
          )
        );
    }

    // Section 3 Fix: Passport share is active ONLY when not revoked AND expiresAt > request.time.toMillis()
    function isPassportActivelyShared(uid) {
      return firestore.exists(/databases/(default)/documents/passportShares/$(uid))
        && firestore.get(/databases/(default)/documents/passportShares/$(uid)).data.revoked != true
        && firestore.get(/databases/(default)/documents/passportShares/$(uid)).data.expiresAt is number
        && firestore.get(/databases/(default)/documents/passportShares/$(uid)).data.expiresAt > request.time.toMillis();
    }

    // 1. Patient Medical Documents (Prescriptions, Lab Reports, Medical Reports)
    // Section 3 Fix: Strictly private to the patient owner ONLY (content editors, reviewers, and regional managers are DENIED)
    match /patient_documents/{uid}/{fileName} {
      allow read: if isOwner(uid);
      allow write: if isOwner(uid)
        && request.resource.size < 8 * 1024 * 1024
        && (
          request.resource.contentType.matches('image/(jpeg|png|webp)')
          || request.resource.contentType == 'application/pdf'
        );
      allow delete: if isOwner(uid);
    }

    // 2. Passport & Identity Photos — Readable ONLY by owner or when Smart Passport share is unrevoked & unexpired
    match /passport_photos/{uid}/{fileName} {
      allow read: if isOwner(uid) || isPassportActivelyShared(uid);
      allow write: if isOwner(uid)
        && request.resource.size < 3 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp)');
      allow delete: if isOwner(uid);
    }

    // 3. Pharmacy License & Verification Documents (Applicant + License Verifier only; never editor/reviewer)
    match /pharmacy_verification_docs/{applicantUid}/{fileName} {
      allow read: if isOwner(applicantUid) || isLicenseVerifier();
      allow write: if isOwner(applicantUid)
        && request.resource.size < 10 * 1024 * 1024
        && (
          request.resource.contentType.matches('image/(jpeg|png|webp)')
          || request.resource.contentType == 'application/pdf'
        );
      allow delete: if isSystemAdmin();
    }

    // 4. Partner & Pharmacy Assets & Order Prescriptions
    // Section 3 & 5 Fix: Prescription uploads are private to the uploading patient and the target pharmacy's clinical staff ONLY
    match /partner_assets/{partnerId}/{fileName} {
      allow read: if !(fileName.matches('prescription_.*'))
        || isPharmacyClinicalStaff(partnerId)
        || (isSignedIn() && resource.metadata != null && resource.metadata.ownerUid == request.auth.uid);
      allow write: if isSignedIn() && (
        (fileName.matches('prescription_.*')
          && request.resource.size < 8 * 1024 * 1024
          && request.resource.metadata != null
          && request.resource.metadata.ownerUid == request.auth.uid
          && (request.resource.contentType.matches('image/(jpeg|png|webp)') || request.resource.contentType == 'application/pdf'))
        ||
        (isPharmacyManagerOrOwner(partnerId)
          && !(fileName.matches('prescription_.*'))
          && request.resource.size < 5 * 1024 * 1024
          && request.resource.contentType.matches('image/(jpeg|png|webp)'))
      );
      allow delete: if isPharmacyManagerOrOwner(partnerId);
    }
  }
}
