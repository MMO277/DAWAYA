rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid && uid.size() > 0;
    }

    function hasAdminOrEditorRole() {
      return isSignedIn() && (
        request.auth.token.role in ['owner', 'super_admin', 'admin', 'regional_manager', 'reviewer', 'editor']
        || firestore.get(/databases/(default)/documents/roles/$(request.auth.uid)).data.role in ['owner', 'super_admin', 'admin', 'regional_manager', 'reviewer', 'editor']
      );
    }

    function isPassportActivelyShared(uid) {
      return firestore.exists(/databases/(default)/documents/passportShares/$(uid))
        && firestore.get(/databases/(default)/documents/passportShares/$(uid)).data.expiresAt > 0;
    }

    // 1. Patient Medical Documents (Prescriptions, Lab Reports, Medical Reports)
    // Strictly private to the authenticated patient or authorized admin reviewer
    match /patient_documents/{uid}/{fileName} {
      allow read: if isOwner(uid) || hasAdminOrEditorRole();
      allow write: if isOwner(uid)
        && request.resource.size < 8 * 1024 * 1024
        && (
          request.resource.contentType.matches('image/(jpeg|png|webp)')
          || request.resource.contentType == 'application/pdf'
        );
      allow delete: if isOwner(uid);
    }

    // 2. Passport Photos — FIXED VULNERABILITY: Protected from unrestricted public scraping
    // Readable only by the owner, admins, or when the patient's Smart Passport share link is active
    match /passport_photos/{uid}/{fileName} {
      allow read: if isOwner(uid) || hasAdminOrEditorRole() || isPassportActivelyShared(uid);
      allow write: if isOwner(uid)
        && request.resource.size < 3 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp)');
      allow delete: if isOwner(uid) || hasAdminOrEditorRole();
    }

    // 3. Pharmacy License & Verification Documents (Protected)
    match /pharmacy_verification_docs/{applicantUid}/{fileName} {
      allow read: if isOwner(applicantUid) || hasAdminOrEditorRole();
      allow write: if isOwner(applicantUid)
        && request.resource.size < 10 * 1024 * 1024
        && (
          request.resource.contentType.matches('image/(jpeg|png|webp)')
          || request.resource.contentType == 'application/pdf'
        );
      allow delete: if hasAdminOrEditorRole();
    }

    // 4. Partner & Pharmacy Assets & Order Prescriptions
    match /partner_assets/{partnerId}/{fileName} {
      allow read: if !(fileName.matches('prescription_.*')) || isSignedIn() || hasAdminOrEditorRole();
      allow write: if isSignedIn() && (
        (fileName.matches('prescription_.*')
          && request.resource.size < 8 * 1024 * 1024
          && (request.resource.contentType.matches('image/(jpeg|png|webp)') || request.resource.contentType == 'application/pdf'))
        ||
        (hasAdminOrEditorRole()
          && request.resource.size < 5 * 1024 * 1024
          && request.resource.contentType.matches('image/(jpeg|png|webp)'))
      );
    }
  }
}
