rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid && uid.size() > 0;
    }

    function hasAdminOrEditorRole() {
      return isSignedIn() && (
        request.auth.token.role in ['owner', 'super_admin', 'admin', 'regional_manager', 'reviewer', 'editor']
        || (
          firestore.exists(/databases/(default)/documents/roles/$(request.auth.uid))
          && firestore.get(/databases/(default)/documents/roles/$(request.auth.uid)).data.role in ['owner', 'super_admin', 'admin', 'regional_manager', 'reviewer', 'editor']
        )
      );
    }

    function isPharmacyMember(partnerId) {
      return isSignedIn()
        && partnerId is string
        && partnerId.size() > 0
        && (
          hasAdminOrEditorRole()
          || (
            firestore.exists(/databases/(default)/documents/roles/$(request.auth.uid))
            && firestore.get(/databases/(default)/documents/roles/$(request.auth.uid)).data.pharmacyId == partnerId
            && firestore.get(/databases/(default)/documents/roles/$(request.auth.uid)).data.role in ['pharmacy_owner', 'pharmacy_manager', 'pharmacist', 'employee']
          )
          || (
            firestore.exists(/databases/(default)/documents/pharmacies/$(partnerId))
            && firestore.get(/databases/(default)/documents/pharmacies/$(partnerId)).data.ownerUid == request.auth.uid
          )
        );
    }

    // Section 3 Fix: Passport share is active ONLY when not revoked AND expiresAt > request.time.toMillis()
    function isPassportActivelyShared(uid) {
      return firestore.exists(/databases/(default)/documents/passportShares/$(uid))
        && firestore.get(/databases/(default)/documents/passportShares/$(uid)).data.revoked != true
        && firestore.get(/databases/(default)/documents/passportShares/$(uid)).data.expiresAt is number
        && firestore.get(/databases/(default)/documents/passportShares/$(uid)).data.expiresAt > request.time.toMillis();
    }

    // 1. Patient Medical Documents (Prescriptions, Lab Reports, Medical Reports)
    // Strictly private to the authenticated patient or authorized admin reviewer
    match /patient_documents/{uid}/{fileName} {
      allow read: if isOwner(uid) || hasAdminOrEditorRole();
      allow write: if isOwner(uid)
        && request.resource.size < 8 * 1024 * 1024
        && (
          request.resource.contentType.matches('image/(jpeg|png|webp)')
          || request.resource.contentType == 'application/pdf'
        );
      allow delete: if isOwner(uid);
    }

    // 2. Passport Photos — Readable only by owner, admins, or when Smart Passport share is unrevoked and unexpired
    match /passport_photos/{uid}/{fileName} {
      allow read: if isOwner(uid) || hasAdminOrEditorRole() || isPassportActivelyShared(uid);
      allow write: if isOwner(uid)
        && request.resource.size < 3 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp)');
      allow delete: if isOwner(uid) || hasAdminOrEditorRole();
    }

    // 3. Pharmacy License & Verification Documents (Protected)
    match /pharmacy_verification_docs/{applicantUid}/{fileName} {
      allow read: if isOwner(applicantUid) || hasAdminOrEditorRole();
      allow write: if isOwner(applicantUid)
        && request.resource.size < 10 * 1024 * 1024
        && (
          request.resource.contentType.matches('image/(jpeg|png|webp)')
          || request.resource.contentType == 'application/pdf'
        );
      allow delete: if hasAdminOrEditorRole();
    }

    // 4. Partner & Pharmacy Assets & Order Prescriptions
    // Section 3 Fix: Prescription uploads are private to the uploading patient, target pharmacy members, or admins
    match /partner_assets/{partnerId}/{fileName} {
      allow read: if !(fileName.matches('prescription_.*'))
        || isPharmacyMember(partnerId)
        || hasAdminOrEditorRole()
        || (isSignedIn() && resource.metadata != null && resource.metadata.ownerUid == request.auth.uid);
      allow write: if isSignedIn() && (
        (fileName.matches('prescription_.*')
          && request.resource.size < 8 * 1024 * 1024
          && request.resource.metadata != null
          && request.resource.metadata.ownerUid == request.auth.uid
          && (request.resource.contentType.matches('image/(jpeg|png|webp)') || request.resource.contentType == 'application/pdf'))
        ||
        ((hasAdminOrEditorRole() || isPharmacyMember(partnerId))
          && !(fileName.matches('prescription_.*'))
          && request.resource.size < 5 * 1024 * 1024
          && request.resource.contentType.matches('image/(jpeg|png|webp)'))
      );
    }
  }
}
